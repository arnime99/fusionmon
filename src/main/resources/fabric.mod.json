{
	"schemaVersion": 1,
	"id": "fusionmon",
	"version": "${version}",
	"name": "Fusionmon",
	"description": "Fuse any two Cobblemon, Pokémon Infinite Fusion style: every pair gets its own model, name, types and stats. Discover fusions as you play, battle with them, ride them and evolve them.",
	"authors": [
		"Rupikola"
	],
	"contact": {
		"homepage": "https://github.com/arnime99/fusionmon",
		"sources": "https://github.com/arnime99/fusionmon",
		"issues": "https://github.com/arnime99/fusionmon/issues"
	},
	"license": "MPL-2.0",
	"icon": "assets/fusionmon/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.arnau.fusionmon.Fusionmon"
		],
		"client": [
			"com.arnau.fusionmon.client.FusionmonClient"
		]
	},
	"mixins": [
		"fusionmon.mixins.json",
		{
			"config": "fusionmon.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.6",
		"cobblemon": "~1.8.1"
	}
}
